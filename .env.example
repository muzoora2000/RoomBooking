# Neon pooled PostgreSQL connection string. SSL is required.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Authentication. Use a long random value (32+ bytes).
JWT_SECRET=replace-with-a-long-random-jwt-secret
OTP_EXPIRY_MINUTES=5
OTP_PEPPER=replace-with-a-different-random-pepper

# Comma separated. First value is used for links in emails and QR codes.
FRONTEND_URL=https://campus.example.ac.ug

# Email over an HTTPS API (Resend by default, Brevo supported with EMAIL_PROVIDER=brevo).
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Campus Navigation <no-reply@example.ac.ug>

# Africa's Talking SMS (HTTP API, never SMTP).
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Web push VAPID keys. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ac.ug

# Protects /api/internal/*. GitHub Actions sends X-Cron-Secret.
CRON_SECRET=replace-with-a-long-random-cron-secret

# QR and check-in signing secrets.
QR_SIGNING_SECRET=replace-with-a-long-random-qr-secret
DOOR_TOKEN_SECRET=replace-with-a-long-random-door-secret

# Timezone for interpreting and displaying user input. Timestamps are stored as UTC.
APP_TIMEZONE=Africa/Kampala

# Optional: disable SSL verification only for local non-Neon databases.
PGSSL=require
PORT=4000
